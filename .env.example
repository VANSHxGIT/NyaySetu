# ═══════════════════════════════════════════════════════════
# NyaySetu — Environment Variables Template
# Copy this file to .env and fill in your real values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════

# ── Database ──
DATABASE_URL=postgresql+asyncpg://nyaysetu_app:CHANGE_ME@localhost:5432/nyaysetu

# ── Authentication ──
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Admin ──
ADMIN_SECRET=CHANGE_ME_ADMIN_BOOTSTRAP_SECRET

# ── API Keys ──
AGENTFOUNDRY_API_KEY=af_CHANGE_ME
OCR_API_KEY=CHANGE_ME
LLM_API_KEY=CHANGE_ME

# ── Deployment ──
DEBUG=False
FORCE_HTTPS=True
ALLOWED_HOST=nyaysetu.example.com
FRONTEND_URL=https://nyaysetu.example.com
